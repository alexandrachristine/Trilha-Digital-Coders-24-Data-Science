import pandas as pd
import re

ARQ_IN  = "Blocked_Softwares.xlsx"          # ajuste o nome se precisar
ABA     = 0                                  # 0 = primeira aba; ou "Sheet1"
COLPATH = "ori_soft"                          # nome da coluna com o path

ARQ_OUT_COMPLETO   = "Blocked_Softwares_Limpo.xlsx"
ARQ_OUT_UNICOS     = "softwares_unicos.xlsx"
ARQ_OUT_FREQUENCIA = "softwares_frequencia.xlsx"

# ===== 1) Ler arquivo =====
df = pd.read_excel(ARQ_IN, sheet_name=ABA)

# Se o cabeçalho estiver diferente, renomeie:
# df = df.rename(columns={"A": "ori_soft"})

# ===== 2) Extrair apenas o "software" do fim do path =====
def extrair_software(s):
    if pd.isna(s): 
        return None
    s = str(s)
    # limpa chaves e parênteses
    s = s.replace("{","").replace("}","").replace("(","").replace(")","")
    s = s.replace("/", "\\")
    # pega o último trecho após a última barra
    arquivo = s.split("\\")[-1].strip()
    # mantém só .exe (opcional) — comente a linha abaixo se quiser todas as extensões
    if not re.search(r"\.exe$", arquivo, flags=re.I):
        return None
    # remove a extensão (.exe, .EXE, etc.)
    base = re.sub(r"\.[A-Za-z0-9]+$", "", arquivo)
    return base or None

df["software"] = df[COLPATH].apply(extrair_software)

# ===== 3) Remover “lixo” por palavras-chave (ajuste à sua realidade) =====
# Ex.: componentes internos do Visual Studio/.NET que você não quer contar
deny_keywords = [
    "msbuild", "vbcsc", "servicehub", "devenv", "dotnet",
    "mscorsvw", "ngen", "vctip", "perfwatson", "vsai",
    "sqlpackage", "vstest", "teamfoundation", "vsixinstaller"
]
# remove nulos, trims e filtra por denylist
df["software"] = df["software"].dropna()
mask_deny = df["software"].str.lower().apply(
    lambda x: any(k in x for k in deny_keywords)
)
df_limpo = df.loc[~mask_deny].copy()

# ===== 4) Salvar tabela completa com coluna nova =====
df_limpo.to_excel(ARQ_OUT_COMPLETO, index=False)

# ===== 5) Gerar listas úteis =====
# únicos (ordenados A→Z)
unicos = (
    df_limpo["software"]
    .dropna()
    .drop_duplicates()
    .sort_values()
    .reset_index(drop=True)
    .to_frame()
)
unicos.columns = ["software"]
unicos.to_excel(ARQ_OUT_UNICOS, index=False)

# ranking (mais frequentes no topo)
freq = (
    df_limpo["software"]
    .value_counts()
    .rename_axis("software")
    .reset_index(name="qtd")
)
freq.to_excel(ARQ_OUT_FREQUENCIA, index=False)

print("OK!")
print(f"- {ARQ_OUT_COMPLETO}")
print(f"- {ARQ_OUT_UNICOS}")
print(f"- {ARQ_OUT_FREQUENCIA}")

allow_paths = ["\\program files\\pactual\\", "\\program files (x86)\\pactual\\"]
keep = df[COLPATH].str.lower().str.contains("|".join(map(re.escape, allow_paths)))
df_limpo = df.loc[keep].copy()
